{
	"name": "kadr/kadr",
	"description": "Kadr — platforma SaaS dla profesjonalnych fotografów.",
	"type": "wordpress-plugin",
	"license": "proprietary",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.11",
		"phpunit/phpunit": "^11",
		"squizlabs/php_codesniffer": "^3.10",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"autoload": {
		"psr-4": {
			"Kadr\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Kadr\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse"
	}
}
